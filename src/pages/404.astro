---
import { getCollection } from "astro:content";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SwapText from "@/components/ui/SwapText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const suggestions = allPosts.slice(0, 3);
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content">
    <div class="container section section-top">
      <div class="notfound">
        <h1 class="txt-h1">This page has moved on.</h1>
        <p class="txt-l txt-dim">
          The story may have been renamed, or the URL may be mistyped. Try the archive or start from
          the front page.
        </p>
        <div class="notfound__actions">
          <a class="btn btn--lg" href="/"><SwapText text="Back to the front page" /></a>
          <a class="btn btn--ghost btn--lg" href="/posts/"><SwapText text="Browse the archive" /></a>
        </div>
      </div>

      <section class="notfound__suggestions" aria-labelledby="notfound-suggestions">
        <h2 id="notfound-suggestions" class="section-head__eyebrow">Recently published</h2>
        <div class="grid-cards grid-cards--3">
          {suggestions.map((post) => <PostCard post={post} eager />)}
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 40rem;
    padding-block: 3rem;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .notfound__suggestions {
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid var(--border);
    padding-top: 2.5rem;
    margin-top: 2rem;
  }
</style>
