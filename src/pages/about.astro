---
import { getCollection } from "astro:content";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PageHeader from "@/components/PageHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import SwapText from "@/components/ui/SwapText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
/** Undefined when the configured byline has no published posts. */
const editor = getAllAuthors(allPosts).find((author) => author.name === siteConfig.editor.name);
---

<BaseLayout
  title="About"
  description={`Learn about ${siteConfig.name}, who writes it, and the kind of writing readers can expect.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content">
    <div class="container">
      <PageHeader title={siteConfig.name} description={siteConfig.bio} />
    </div>

    <section class="container section section-top">
      <div class="about-grid">
        <div class="about-body">
          <div class="about-block">
            <h2 class="txt-h3">What we publish</h2>
            <p class="txt-m txt-dim">
              {siteConfig.name} covers technology at the level where decisions are actually made: the hardware
              trade-off behind a product, the infrastructure behind a service, and the argument behind a
              default nobody voted for.
            </p>
          </div>
          <div class="about-block">
            <h2 class="txt-h3">How we write it</h2>
            <p class="txt-m txt-dim">
              Stories should be specific, honest about what is unknown, and useful to someone who has to make
              a decision. We would rather explain one constraint properly than list ten features.
            </p>
          </div>
        </div>

        {
          editor && (
            <aside class="about-editor" aria-labelledby="about-editor-heading">
              <h2 id="about-editor-heading" class="txt-h4">
                {siteConfig.editor.title}
              </h2>
              <div class="about-editor__person">
                <Avatar name={editor.name} size="xl" />
                <div class="about-editor__identity">
                  <p class="txt-h5">{editor.name}</p>
                  <p class="txt-xs txt-dim">{editor.role}</p>
                </div>
              </div>
              <p class="txt-s txt-dim">
                {siteConfig.editor.bio ||
                  `${editor.name} assigns and edits most of what runs here, and answers for the calls the desk gets wrong.`}
              </p>
              <a class="section-link txt-sub-xs" href={`/author/${editor.slug}/`}>
                <SwapText text="Read their stories" />
                <span class="section-link__arrow">
                  <Icon name="arrow-right" size={14} />
                </span>
              </a>
            </aside>
          )
        }
      </div>
    </section>

    <NewsletterSignup id="about-newsletter" />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 64rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .about-body {
    display: grid;
    gap: 2.5rem;
  }

  .about-block {
    display: grid;
    gap: 0.75rem;
  }

  /* No panel here: the portrait and the rule-free stack are enough structure
     for a column this narrow. */
  .about-editor {
    display: grid;
    justify-items: start;
    gap: 1rem;
    align-content: start;
  }

  .about-editor__person {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .about-editor__identity {
    display: grid;
    gap: 0.15rem;
  }
</style>
