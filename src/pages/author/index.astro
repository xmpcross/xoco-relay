---
import { getCollection } from "astro:content";
import PageHeader from "@/components/PageHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Avatar from "@/components/ui/Avatar.astro";
import SwapText from "@/components/ui/SwapText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout title="Authors" description={`Browse ${siteConfig.name} authors and their latest articles.`}>
  <SiteHeader posts={allPosts} />
  <main id="content">
    <div class="container">
      <PageHeader
        title="Authors"
        description={`The writers behind ${siteConfig.name} — devices, apps and tools, platforms, security, robotics, and culture.`}
        meta={`${authors.length} ${authors.length === 1 ? "author" : "authors"}`}
      />
    </div>

    <section class="container section section-top">
      <div class="authors-grid hover-fade-group">
        {
          authors.map((author) => (
            <a class="panel author-card" href={`/author/${author.slug}/`}>
              <Avatar name={author.name} size="lg" />
              <div class="author-card__body">
                <h2 class="txt-h4">
                  <SwapText text={author.name} />
                </h2>
                <p class="txt-s txt-dim">{author.role}</p>
                <p class="txt-cap txt-dim author-card__count">
                  {author.posts.length} {author.posts.length === 1 ? "post" : "posts"}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .authors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .authors-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .authors-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .author-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
  }

  .author-card__body {
    min-width: 0;
    display: grid;
    gap: 0.25rem;
  }

  .author-card__count {
    margin-top: 0.35rem;
  }
</style>
