---
/**
 * Small stroked UI icons on a 24x24 grid. Editorial chrome only — social and
 * brand marks still come from LocalIcon.
 */
export type IconName =
  | "arrow-right"
  | "arrow-left"
  | "chevron-down"
  | "search"
  | "sun"
  | "moon"
  | "menu"
  | "close"
  | "link";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = "", size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow-right" && <path d="M5 12h13m-6-6 6 6-6 6" />}
  {name === "arrow-left" && <path d="M19 12H6m6-6-6 6 6 6" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16.5 16.5 4 4" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" />
      </>
    )
  }
  {name === "moon" && <path d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {name === "link" && <path d="M10 13a5 5 0 0 0 7.1 0l2.4-2.4a5 5 0 0 0-7.1-7.1L11 4.9M14 11a5 5 0 0 0-7.1 0L4.5 13.4a5 5 0 0 0 7.1 7.1l1.4-1.4" />}
</svg>
